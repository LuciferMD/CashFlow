{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Username=postgres;Password=postgres;Database=cashFlow_auth"
  },
  "Microservices": {
    "Frontend": "http://localhost:3000"
  },
  "JwtOptions": {
    "ExpiersHours": 24,
    "PrivateKeyPath": "keys/jwt-private.pem",
    "PublicKeyPath": "keys/jwt-public.pem",
    "Issuer": "CashFlow.Auth",
    "Audience": "CashFlow"
  }
}

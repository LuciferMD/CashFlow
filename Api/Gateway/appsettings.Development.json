{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Elastic.Apm": "Warning"
      }
    }
  },
  "JwtOptions": {
    "PublicKeyPath": "keys/jwt-public.pem",
    "Issuer": "CashFlow.Auth",
    "Audience": "CashFlow"
  },
  "Elasticsearch": {
    "Uri": "http://localhost:9200"
  },
  "ElasticApm": {
    "ServerUrl": "http://localhost:8200"
  }
}

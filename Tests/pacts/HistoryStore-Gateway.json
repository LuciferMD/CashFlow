{
  "consumer": {
    "name": "HistoryStore"
  },
  "messages": [
    {
      "contents": {
        "capturedAt": "2024-06-15T10:00:00.000Z",
        "devices": [
          {
            "name": "Kitchen",
            "payload": {
              "co2": 400,
              "energy": 1.5,
              "humidity": 60,
              "pm25": 10
            },
            "type": "sensor"
          }
        ]
      },
      "description": "an IoT snapshot with device readings",
      "matchingRules": {
        "body": {
          "$.capturedAt": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          },
          "$.devices": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type",
                "min": 1
              }
            ]
          },
          "$.devices[*].name": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          },
          "$.devices[*].payload": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          },
          "$.devices[*].payload.co2": {
            "combine": "AND",
            "matchers": [
              {
                "match": "integer"
              }
            ]
          },
          "$.devices[*].payload.energy": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          },
          "$.devices[*].payload.humidity": {
            "combine": "AND",
            "matchers": [
              {
                "match": "integer"
              }
            ]
          },
          "$.devices[*].payload.pm25": {
            "combine": "AND",
            "matchers": [
              {
                "match": "integer"
              }
            ]
          },
          "$.devices[*].type": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          }
        },
        "metadata": {}
      },
      "metadata": {
        "contentType": "application/json"
      },
      "providerStates": [
        {
          "name": "Gateway published a snapshot to iot.snapshots"
        }
      ]
    },
    {
      "contents": {
        "capturedAt": "2024-06-15T10:00:00.000Z",
        "devices": [
          {
            "name": "Hall",
            "payload": {
              "humidity": 55
            },
            "type": "sensor"
          }
        ]
      },
      "description": "an IoT snapshot with nullable payload fields",
      "matchingRules": {
        "body": {
          "$.capturedAt": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          },
          "$.devices": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type",
                "min": 1
              }
            ]
          },
          "$.devices[*].name": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          },
          "$.devices[*].payload": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          },
          "$.devices[*].payload.humidity": {
            "combine": "AND",
            "matchers": [
              {
                "match": "integer"
              }
            ]
          },
          "$.devices[*].type": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          }
        },
        "metadata": {}
      },
      "metadata": {
        "contentType": "application/json"
      },
      "providerStates": [
        {
          "name": "Gateway published a snapshot with sparse device payload"
        }
      ]
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "13.2.0"
    },
    "pactRust": {
      "ffi": "0.4.22",
      "models": "1.2.3"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "Gateway"
  }
}
{
  "consumer": {
    "name": "Web"
  },
  "interactions": [
    {
      "description": "a GraphQL request for IoT devices",
      "pending": false,
      "providerStates": [
        {
          "name": "authenticated user requests IoT devices"
        }
      ],
      "request": {
        "body": {
          "content": {
            "query": "query GetIot { iot { devices { type name payload { co2 pm25 humidity energy } } } }"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Authorization": [
            "Bearer contract-test-jwt"
          ],
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.query": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          },
          "header": {
            "Authorization": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/graphql"
      },
      "response": {
        "body": {
          "content": {
            "data": {
              "iot": {
                "devices": [
                  {
                    "name": "Kitchen",
                    "payload": {
                      "co2": 400,
                      "energy": 1.5,
                      "humidity": 60,
                      "pm25": 10
                    },
                    "type": "sensor"
                  }
                ]
              }
            }
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.data.iot.devices": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.data.iot.devices[*].name": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.data.iot.devices[*].payload": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.data.iot.devices[*].payload.co2": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.data.iot.devices[*].payload.energy": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.data.iot.devices[*].payload.humidity": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.data.iot.devices[*].payload.pm25": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.data.iot.devices[*].type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^application\\/(json|graphql-response\\+json)(;.*)?$"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.0.1"
    },
    "pactRust": {
      "ffi": "0.5.4",
      "models": "1.3.11"
    },
    "pactSpecification": {
      "version": "4.0"
    }
  },
  "provider": {
    "name": "Gateway"
  }
}
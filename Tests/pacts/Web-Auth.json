{
  "consumer": {
    "name": "Web"
  },
  "interactions": [
    {
      "description": "a failed login request",
      "pending": false,
      "providerStates": [
        {
          "name": "credentials are invalid"
        }
      ],
      "request": {
        "body": {
          "content": {
            "email": "unknown@example.com",
            "password": "wrong-password"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.email": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.password": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/auth/login"
      },
      "response": {
        "status": 401
      },
      "type": "Synchronous/HTTP"
    },
    {
      "description": "a registration request",
      "pending": false,
      "providerStates": [
        {
          "name": "registration is available"
        }
      ],
      "request": {
        "body": {
          "content": {
            "email": "contract-user@example.com",
            "password": "SecurePass1!",
            "userName": "contract-user"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.email": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^[\\w.-]+@example\\.com$"
                }
              ]
            },
            "$.password": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.userName": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/auth/register"
      },
      "response": {
        "headers": {
          "Set-Cookie": [
            "GuardPass=signed-jwt; path=/; samesite=strict; httponly"
          ]
        },
        "matchingRules": {
          "header": {
            "Set-Cookie": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^GuardPass=[^;]+; path=\\/; samesite=strict; httponly$"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    },
    {
      "description": "a successful login request",
      "pending": false,
      "providerStates": [
        {
          "name": "user exists with valid credentials"
        }
      ],
      "request": {
        "body": {
          "content": {
            "email": "contract-user@example.com",
            "password": "SecurePass1!"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.email": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.password": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/auth/login"
      },
      "response": {
        "headers": {
          "Set-Cookie": [
            "GuardPass=signed-jwt; path=/; samesite=strict; httponly"
          ]
        },
        "matchingRules": {
          "header": {
            "Set-Cookie": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^GuardPass=[^;]+; path=\\/; samesite=strict; httponly$"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.0.1"
    },
    "pactRust": {
      "ffi": "0.5.4",
      "models": "1.3.11"
    },
    "pactSpecification": {
      "version": "4.0"
    }
  },
  "provider": {
    "name": "Auth"
  }
}
{
  "name": "history-store-tests",
  "version": "1.0.0",
  "description": "Jest unit and integration tests for the HistoryStore Node.js service",
  "type": "commonjs",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/unit/**/*.test.js",
      "**/integration/**/*.test.js"
    ],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "../../Api/HistoryStore/history_store/src/**/*.js"
    ],
    "coverageReporters": ["text", "lcov"]
  }
}

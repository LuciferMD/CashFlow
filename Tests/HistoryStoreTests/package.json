{
  "name": "history-store-tests",
  "version": "1.0.0",
  "description": "Jest unit and service tests for the HistoryStore Node.js service",
  "type": "commonjs",
  "scripts": {
    "test": "jest",
    "test:unit": "jest unit/",
    "test:service": "jest service/",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "jest": "^29.7.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb-memory-server": "^10.1.4",
    "mongoose": "^9.7.2",
    "supertest": "^7.1.1"
  },
  "jest": {
    "projects": [
      {
        "displayName": "unit",
        "testEnvironment": "node",
        "testMatch": ["**/unit/**/*.test.js"]
      },
      {
        "displayName": "service",
        "testEnvironment": "node",
        "testMatch": ["**/service/**/*.test.js"],
        "moduleNameMapper": {
          "^mongoose$": "<rootDir>/node_modules/mongoose"
        }
      }
    ],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "../../Api/HistoryStore/history_store/src/**/*.js"
    ],
    "coverageReporters": ["text", "lcov"]
  }
}
